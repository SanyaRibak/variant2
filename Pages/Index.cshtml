@page
@model IndexModel
@{ ViewData["Title"] = "Каталог"; }
<div class="catalog-heading">
<div><h1 class="h3 mb-1">@(Model.CategoryName == null ? "Все товары" : char.ToUpper(Model.CategoryName[0]) + Model.CategoryName[1..])</h1>
<p class="text-muted mb-0">Объявлений: @Model.Items.Count</p></div>
<form method="get" class="search-form">
<label class="visually-hidden" asp-for="Search">Название товара</label>
<input class="form-control" asp-for="Search" placeholder="Поиск по названию" maxlength="80" />
<button class="btn btn-primary" type="submit">Найти</button>
</form>
</div>
@if (Model.Items.Count == 0) { <p>Объявления не найдены.</p> }
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
@foreach (var item in Model.Items)
{
<div class="col"><article class="card h-100">
<a asp-page="/Items/Details" asp-route-id="@item.Id"><img class="item-photo" src="@item.ImagePath" asp-append-version="true" alt="@item.Title" /></a>
<div class="card-body d-flex flex-column">
<div class="d-flex justify-content-between gap-2 mb-3"><span class="text-muted small">@item.Category</span><strong class="text-nowrap">@item.Price.ToString("N0") ₽</strong></div>
<h2 class="h5 card-title">@item.Title</h2>
@if (item.IsReserved) { <p class="small text-secondary">Забронирован</p> }
<a class="details-link mt-auto pt-3" asp-page="/Items/Details" asp-route-id="@item.Id">Посмотреть объявление →</a>
</div></article></div>
}
</div>
